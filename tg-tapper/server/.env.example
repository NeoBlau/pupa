# Token from @BotFather
BOT_TOKEN=123456:ABC...
# Public HTTPS URL where this server is reachable (the Mini App is served from it too).
# Leave empty to use long polling for bot updates (handy locally).
PUBLIC_URL=https://your-domain.com
# Short name of the Mini App registered in @BotFather (/newapp), used for referral links
APP_SHORT_NAME=play
PORT=8080
DB_PATH=./data/game.db
# 1 = accept "dev:<id>" auth without Telegram (NEVER enable in production)
ALLOW_DEV=0
